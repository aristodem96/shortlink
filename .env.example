# Copy to .env and adjust. docker-compose reads this file automatically.
#
# A few values below are used by `make run`, which starts the binaries directly,
# but not under `docker compose up`: HTTP_ADDR, POSTGRES_DSN, REDIS_ADDR,
# REDIS_PASSWORD and REDIS_DB. Inside the stack the containers reach each other
# over the compose network, so those are fixed there -- overriding them would
# only point a container at an address that does not exist from inside it. To
# change the port the API is published on, set API_PORT.

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Public base URL used to build short links in API responses
BASE_URL=http://localhost:8080

# Postgres
POSTGRES_DSN=postgres://shortlink:shortlink@localhost:5432/shortlink?sslmode=disable
POSTGRES_MAX_CONNS=10

# Redis. These two are read by `make run` and by production; under
# `docker compose up` the stack talks to its own Redis container, which runs
# without a password on database 0, so setting them there would only break the
# connection.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTLs
CACHE_TTL=1h
CACHE_NEGATIVE_TTL=30s

# Short code generation
CODE_LENGTH=7

# Rate limiting (token bucket, per API key or per client IP)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Click analytics collector
CLICKS_BUFFER_SIZE=10000
CLICKS_WORKERS=2
CLICKS_BATCH_SIZE=500
CLICKS_FLUSH_INTERVAL=2s

# Privacy: salt used to hash visitor IPs before storing them
IP_HASH_SALT=change-me-in-production

# Read the client address from X-Forwarded-For instead of the socket. Leave it
# false unless a proxy that overwrites the header really sits in front: the
# header is client-controlled, so trusting it on a directly exposed service
# lets anyone forge an address and evade the per-IP rate limit.
TRUST_PROXY_HEADERS=false

# logging: debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=json

# --- Telegram bot (optional) -------------------------------------------------
# The bot sells API access: a user pays in crypto through @CryptoBot and then
# mints their own keys in the chat. It is off unless enabled:
#   make bot            run it locally with `go run`
#   COMPOSE_PROFILES=bot to start it with `docker compose up`

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# From @CryptoTestnetBot for testnet, @CryptoBot for mainnet: Crypto Pay -> Create App.
# A testnet token only works against testnet, and a mainnet one only on mainnet.
CRYPTOPAY_TOKEN=

# testnet | mainnet. Defaults to testnet so a bot started without thinking
# cannot take real money.
CRYPTOPAY_NETWORK=testnet

PRICE_USD=10
ACCESS_DAYS=5
MAX_KEYS_PER_USER=5
CRYPTOPAY_ASSETS=USDT,TON

# One-off price of a custom domain slot. A buyer who pays this can register one
# domain of their own; their links are then served from it.
CUSTOM_DOMAIN_PRICE_USD=5

# This server's public address. A customer's domain is accepted only when its
# A or AAAA record resolves to one of these. Empty disables the check, which is
# right locally -- there is no public address to point a domain at -- and wrong
# anywhere reachable from the internet.
SERVER_IP=

# How long an invoice stays payable. A user who taps /buy again within half of
# this gets the same invoice back instead of a new one.
INVOICE_TTL=1h

# How often pending invoices are checked with the provider. This is what makes
# payments go through locally, where Crypto Pay has no public URL to send a
# webhook to.
RECONCILE_INTERVAL=20s

# Dates the bot shows are rendered in this zone, and always name it.
BOT_TIMEZONE=Europe/Kyiv

# Host port for the bot's payment webhook, published in development so it can be
# exercised locally or through a tunnel. Production does not publish it.
BOT_PORT=8090

# The Bot API endpoint. Telegram publishes the server itself, so a deployment
# may run its own; pointing this elsewhere is also how the whole conversation
# is exercised against a stand-in.
TELEGRAM_API_URL=https://api.telegram.org
