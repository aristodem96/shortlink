# Production secrets. Copy to .env ON THE SERVER and fill in real values.
# Never commit the filled-in file: .gitignore already excludes .env.
#
# Generate each secret with:  openssl rand -base64 32

# The domain that points at this server. Caddy requests a certificate for it,
# and it becomes the prefix of every short link the API returns.
SHORTLINK_DOMAIN=sho.rt

# This server's public IP address. Required: a customer may only register a
# custom domain whose A record resolves here, and this is what that is checked
# against. Several addresses may be listed, comma-separated, e.g. an IPv4 and
# an IPv6 one.
SERVER_IP=

# Optional, SPACE-separated. Hostnames this server should keep answering on
# besides SHORTLINK_DOMAIN -- a domain you have moved away from, whose links are
# already out in the world. Caddy obtains a certificate for each.
#EXTRA_DOMAINS=old.example older.example

# Postgres credentials. Changing these after the first start does NOT change
# the existing database -- the volume keeps the old ones.
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=
POSTGRES_DB=shortlink

# Redis password.
REDIS_PASSWORD=

# Salt for visitor IP hashes. Rotating it invalidates every existing hash, so
# unique-visitor counts restart from zero; pick one and keep it.
IP_HASH_SALT=

# debug | info | warn | error
LOG_LEVEL=info

# --- Telegram bot --------------------------------------------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# From @CryptoBot (mainnet) or @CryptoTestnetBot (testnet): Crypto Pay -> Create App.
CRYPTOPAY_TOKEN=

# Required, no default. A server left on testnet sells real access for test
# coins that cost nothing, so this has to be a conscious choice.
CRYPTOPAY_NETWORK=

# ---------------------------------------------------------------------------
# Optional tuning. Every line below is commented out and shows the default the
# service uses, so an untouched file changes nothing. Uncomment to override.
# ---------------------------------------------------------------------------

# What access costs, how long it lasts, and how many keys one buyer may hold.
#PRICE_USD=10
#ACCESS_DAYS=5
#MAX_KEYS_PER_USER=5

# One-off price of a custom domain slot. A buyer who pays this registers one
# domain of their own and their links are served from it; the domain works only
# while their API access is live.
#CUSTOM_DOMAIN_PRICE_USD=5

# Crypto assets the invoice accepts, in @CryptoBot's notation.
#CRYPTOPAY_ASSETS=USDT,TON

# How long an invoice stays payable. A buyer who taps /buy again within half of
# this gets the same invoice back instead of a second one.
#INVOICE_TTL=1h

# How often pending invoices are re-checked with the provider. The webhook is
# the fast path; this is the safety net that closes a sale whose webhook was
# lost, so do not raise it far.
#RECONCILE_INTERVAL=20s

# Dates the bot shows buyers are rendered in this zone, and always name it.
#BOT_TIMEZONE=Europe/Kyiv

# Requests per second per API key (or per IP for anonymous redirects), and the
# size of the burst allowed above that rate.
#RATE_LIMIT_RPS=20
#RATE_LIMIT_BURST=40

# How long a resolved link stays cached, and how long a "no such code" answer
# does. The negative TTL is short so a newly created link is not shadowed by a
# cached miss.
#CACHE_TTL=1h
#CACHE_NEGATIVE_TTL=30s

# Characters in a generated short code. Raise it when
# shortlink_code_collisions_total starts moving.
#CODE_LENGTH=7

# Postgres pool size. Raise it before the pool becomes the bottleneck, but stay
# under the server's max_connections.
#POSTGRES_MAX_CONNS=10

# Click analytics. A rising shortlink_clicks_dropped_total means the buffer is
# too small or the workers cannot keep up.
#CLICKS_BUFFER_SIZE=10000
#CLICKS_WORKERS=2
#CLICKS_BATCH_SIZE=500
#CLICKS_FLUSH_INTERVAL=2s

# HTTP timeouts. The shutdown timeout bounds how long a deploy waits for
# in-flight requests and buffered clicks to finish.
#HTTP_READ_TIMEOUT=5s
#HTTP_WRITE_TIMEOUT=10s
#HTTP_IDLE_TIMEOUT=60s
#HTTP_SHUTDOWN_TIMEOUT=15s
